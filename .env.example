# Closed-API generators and LLM critic (Claude Haiku 4.5)
OPENROUTER_API_KEY=

# Optional — HuggingFace Hub token for higher rate limits
HF_TOKEN=

# Optional — HuggingFace cache directory (defaults to ~/.cache/huggingface)
# HF_HOME=/path/to/hf_cache

# SWE-Bench harness — force local Docker builds (avoids docker.io/swebench pulls)
SWEBENCH_NAMESPACE=none

# Docker client timeout for large image pulls (seconds)
DOCKER_CLIENT_TIMEOUT=600
